{
  "name": "mo-blog",
  "version": "1.5.0",
  "description": "默·博客 — 一册记录日常的随笔（古典风格博客系统）",
  "main": "server.js",
  "scripts": {
    "build:assets": "esbuild src/admin-entry.js --bundle --minify --platform=browser --target=es2020 --outfile=public/js/admin.bundle.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "dependencies": {
    "highlight.js": "11.11.1",
    "markdown-it": "15.0.0",
    "markdown-it-anchor": "9.2.1",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-toc-done-right": "4.2.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.1",
    "codemirror": "6.0.2",
    "esbuild": "0.28.1"
  }
}
